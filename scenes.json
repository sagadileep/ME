{
  "version": "v2-draft",
  "date": "2026-10-26",
  "note": "Draft scene bank. Options turn public-domain IPIP behaviours (Goldberg) into choices; situations span the Situational Eight DIAMONDS (Rauthmann et al. 2014). Effect values are first guesses on the 1-7 scale, to be calibrated against TIPI results. v2: restaurant option 4 now measures spending on experience; two twin scenes (twin_of) re-measure Extraversion and Openness in a new situation, for the sincerity check.",
  "scenes": [
    {
      "id": "restaurant",
      "target": "Openness",
      "type": "text",
      "text": "A new restaurant. The menu has a dish you have never heard of.",
      "options": [
        {
          "text": "Order the unknown dish",
          "effects": {
            "Openness": 1.5
          }
        },
        {
          "text": "Ask the waiter, then decide",
          "effects": {
            "Openness": 0.5,
            "Conscientiousness": 0.5
          }
        },
        {
          "text": "Order a favourite you know",
          "effects": {
            "Openness": -1.0
          }
        },
        {
          "text": "Order many dishes for the table",
          "effects": {
            "Stimulation": 1.0,
            "Extraversion": 0.5,
            "Security": -0.5
          }
        }
      ]
    },
    {
